# 本地运行，不需要 Docker。不要提交 .env 或真实密钥。
# 可通过 --env /Users/jiao/mockinterview/.env 复用 Go 版配置，不复制密钥。
# shell 环境变量优先于这里的值；SQLite/checkpoint 不保存模型密钥。

QUESTIONER_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

EVALUATOR_MODEL=qwen-plus
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：按角色覆盖厂商配置（换成其他兼容 Chat Completions 的服务时使用）。
# QUESTIONER_API_KEY=
# QUESTIONER_BASE_URL=
# EVALUATOR_API_KEY=
# EVALUATOR_BASE_URL=

MODEL_TIMEOUT=300
SESSION_TOKEN_BUDGET=200000
